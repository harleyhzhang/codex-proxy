# Optional second native Codex profile. Use an absolute path to its isolated CODEX_HOME.
# ACCOUNT_CODEX_HOME=/path/to/secondary-codex-profile
# ACCOUNT_CODEX_BINARY=codex
# ACCOUNT_MODEL_PREFIX=secondary
# ACCOUNT_LABEL=Secondary

# Optional native-model allowlist; otherwise expose available GPT models from that profile.
# ACCOUNT_MODELS=gpt-6.1-sol,gpt-6-astra

# Optional identity/workspace pins. Supply your own values locally; never commit credentials.
# ACCOUNT_EXPECTED_EMAIL=account@example.com
# ACCOUNT_EXPECTED_WORKSPACE=your-workspace-id

# Speed policies are opt-in. Omitted values preserve the client's selected tier.
# ACCOUNT_SPEED_POLICY=fastest
# PRIMARY_SPEED_POLICY=standard

# Optional second Claude subscription. Use a separate absolute configuration directory.
# Sign in first: CLAUDE_CONFIG_DIR=/path/to/secondary-claude claude auth login --claudeai
# CLAUDE_ACCOUNT_CONFIG_DIR=/path/to/secondary-claude
# CLAUDE_ACCOUNT_MODEL_PREFIX=secondary
# CLAUDE_ACCOUNT_LABEL=Secondary
# CLAUDE_ACCOUNT_MODELS=claude-opus-5-5,claude-fable-5-1
# CLAUDE_ACCOUNT_BIN=claude
# CLAUDE_ACCOUNT_EXPECTED_EMAIL=account@example.com
# CLAUDE_ACCOUNT_EXPECTED_ORG=your-claude-organization-id
# CLAUDE_EXPECTED_EMAIL=primary@example.com
# CLAUDE_EXPECTED_ORG=your-primary-claude-organization-id
